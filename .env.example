# تنظیمات اصلی سرور بک‌ند
PROJECT_NAME=""
BACKEND_URL=""

# تنظیمات امنیتی (یک رشته طولانی و تصادفی تولید کن)
SECRET_KEY="your_super_safe_and_random_secret_key_here"
ALGORITHM=""

# آدرس‌های مجاز فرانت‌ند (با کاما جدا شوند)
ALLOWED_ORIGINS="http://"

# اتصال دیتابیس پستگرس
SQLALCHEMY_DATABASE_URL="postgresql://user:xxxxxx@db/db"

# اتصال سرور ردیس
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
EITAA_REDIS_HOST="127.0.0.1"
EITAA_REDIS_PORT=6389
ACCOUNT_KEY="latest_session:default"

# آدرس پروکسی اختصاصی ایتا
EITAA_API_URL="http://127.0.0.1:3000/send"
# موقتاً ایزوله از بریج ایتا (mock /proxy-upload، بدون HTTP به :3000/send)
EITAA_DISABLED=true
NEXT_PUBLIC_API_URL="http://localhost:8000"
# تنظیمات دیتابیس پستگرس برای داکر کامپوز
POSTGRES_USER="emtedad_user"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_DB="emtedad_db"

# بات بله برای ثبت رسید واریز کیف پول (در backend/.env قرار بگیرد)
BALE_BOT_TOKEN=""
# رشته تصادفی؛ با هدر X-Telegram-Bot-Api-Secret-Token مقایسه می‌شود
BALE_WEBHOOK_SECRET=""
# شناسه گروه/کانال ادمین‌ها که رسیدها به آن ارسال می‌شود
BALE_ADMIN_CHAT_ID=""
# شناسه کاربری بله ادمین‌های مجاز به تأیید/رد (با کاما جدا شوند)
BALE_ADMIN_USER_IDS=""
# سقف مبلغ هر رسید (ریال)
BALE_MAX_AMOUNT=100000000
# حداکثر رسید در انتظار بررسی برای هر کاربر
BALE_MAX_PENDING_PER_USER=3
